@model HotelGestion.Models.Empleado
@{
    ViewData["Title"] = "Crear Empleado";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-user-plus"></i> Registrar Nuevo Empleado
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <div class="mb-4">
                            <h5 class="text-primary border-bottom pb-2">
                                <i class="fas fa-id-card"></i> Información Personal
                            </h5>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Nombre" class="form-label fw-bold">
                                        <i class="fas fa-user"></i> Nombre *
                                    </label>
                                    <input asp-for="Nombre" class="form-control" placeholder="Ingrese el nombre" />
                                    <span asp-validation-for="Nombre" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="Apellido" class="form-label fw-bold">
                                        <i class="fas fa-user"></i> Apellido *
                                    </label>
                                    <input asp-for="Apellido" class="form-control" placeholder="Ingrese el apellido" />
                                    <span asp-validation-for="Apellido" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Documento" class="form-label fw-bold">
                                        <i class="fas fa-id-badge"></i> Documento
                                    </label>
                                    <input asp-for="Documento" class="form-control" placeholder="Ej: 1234567890" />
                                    <span asp-validation-for="Documento" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="Telefono" class="form-label fw-bold">
                                        <i class="fas fa-phone"></i> Teléfono
                                    </label>
                                    <input asp-for="Telefono" class="form-control" type="tel" placeholder="Ej: +57 300 1234567" />
                                    <span asp-validation-for="Telefono" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Correo" class="form-label fw-bold">
                                    <i class="fas fa-envelope"></i> Correo Electrónico
                                </label>
                                <input asp-for="Correo" class="form-control" type="email" placeholder="ejemplo@hotel.com" />
                                <span asp-validation-for="Correo" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="mb-4">
                            <h5 class="text-primary border-bottom pb-2">
                                <i class="fas fa-briefcase"></i> Información Laboral
                            </h5>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Cargo" class="form-label fw-bold">
                                        <i class="fas fa-user-tie"></i> Cargo *
                                    </label>
                                    <input asp-for="Cargo" class="form-control" placeholder="Ej: Recepcionista" />
                                    <span asp-validation-for="Cargo" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="Sexo" class="form-label fw-bold">
                                        <i class="fas fa-star"></i> Sexo
                                    </label>
                                    <select asp-for="Sexo" class="form-select">
                                        <option value="">-- Seleccione --</option>
                                        <option value="Hombre">Hombre</option>
                                        <option value="Mujer">Mujer</option>
                                    </select>
                                    <span asp-validation-for="Sexo" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="IdTurno" class="form-label fw-bold">
                                        <i class="fas fa-clock"></i> Turno *
                                    </label>
                                    <select asp-for="IdTurno" class="form-select" asp-items="ViewBag.IdTurno">
                                        <option value="">-- Seleccione un turno --</option>
                                    </select>
                                    <span asp-validation-for="IdTurno" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Salario" class="form-label fw-bold">
                                        <i class="fas fa-money-bill-wave"></i> Salario *
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="Salario" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                                    </div>
                                    <span asp-validation-for="Salario" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="FechaContratacion" class="form-label fw-bold">
                                        <i class="fas fa-calendar-alt"></i> Fecha de Contratación *
                                    </label>
                                    <input asp-for="FechaContratacion" class="form-control" type="date" />
                                    <span asp-validation-for="FechaContratacion" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Botones -->
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="fas fa-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-save"></i> Crear Empleado
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}