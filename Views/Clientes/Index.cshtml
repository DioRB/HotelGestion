@model IEnumerable<HotelGestion.Models.Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="fas fa-user-friends"></i> Gestión de Clientes
        </h2>
        <a asp-action="Create" class="btn btn-primary btn-lg">
            <i class="fas fa-plus"></i> Nuevo Cliente
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Documento</th>
                                <th>Nombre Completo</th>
                                <th>Tipo Cliente</th>
                                <th>País</th>
                                <th>Teléfono</th>
                                <th>Correo</th>
                                <th>Sexo</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cliente in Model)
                            {
                                var tipoClass = cliente.TipoCliente == "VIP" ? "bg-warning" :
                                cliente.TipoCliente == "Corporativo" ? "bg-info" :
                                cliente.TipoCliente == "Premium" ? "bg-success" : "bg-secondary";
                                <tr>
                                    <td>
                                        <i class="fas fa-id-card text-muted"></i> @cliente.Documento
                                    </td>
                                    <td>
                                        <strong>
                                            <i class="fas fa-user text-muted"></i>
                                            @cliente.Nombre @cliente.Apellido
                                        </strong>
                                    </td>

                                    <td>
                                        <span class="badge @tipoClass">@cliente.TipoCliente</span>
                                    </td>
                                    <td>
                                        <i class="fas fa-globe text-muted"></i> @cliente.Pais
                                    </td>
                                    <td>
                                        <i class="fas fa-phone text-muted"></i> @cliente.Telefono
                                    </td>
                                    <td>
                                        <i class="fas fa-envelope text-muted"></i>
                                        <small>@cliente.Correo</small>
                                    </td>
                                    <td>@cliente.Sexo</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@cliente.IdPersona" class="btn btn-primary">Editar</a> |
                                            <a asp-action="Delete" asp-route-id="@cliente.IdPersona" class="btn btn-danger">Borrar</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3 text-muted">
                    <i class="fas fa-info-circle"></i> Total de clientes: <strong>@Model.Count()</strong>
                </div>
                <div class="mt-3 text-muted">
                    <i class="fas fa-info-circle"></i> Total de clientes hombres: <strong>@Model.Count(c => c.Sexo == "Hombre")</strong>
                </div>
                <div class="mt-3 text-muted">
                    <i class="fas fa-info-circle"></i> Total de clientes hombres: <strong>@Model.Count(c => c.Sexo == "Mujer")</strong>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle fa-2x mb-3"></i>
                    <p class="mb-0">No hay clientes registrados. <a asp-action="Create" class="alert-link">Crear el primero</a></p>
                </div>
            }
        </div>
    </div>
</div>

<div class="rellenar"></div>