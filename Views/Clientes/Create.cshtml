@model HotelGestion.Models.Cliente
@{
    ViewData["Title"] = "Crear Cliente";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-user-plus"></i> Registrar Nuevo Cliente
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <div class="mb-4">
                            <h5 class="text-primary border-bottom pb-2">
                                <i class="fas fa-id-card"></i> Información Personal
                            </h5>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Nombre" class="form-label fw-bold">
                                        <i class="fas fa-user"></i> Nombre *
                                    </label>
                                    <input asp-for="Nombre" class="form-control" placeholder="Ingrese el nombre" />
                                    <span asp-validation-for="Nombre" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="Apellido" class="form-label fw-bold">
                                        <i class="fas fa-user"></i> Apellido *
                                    </label>
                                    <input asp-for="Apellido" class="form-control" placeholder="Ingrese el apellido" />
                                    <span asp-validation-for="Apellido" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Documento" class="form-label fw-bold">
                                    <i class="fas fa-id-badge"></i> Documento *
                                </label>
                                <input asp-for="Documento" class="form-control" placeholder="Ej: 1234567890" />
                                <span asp-validation-for="Documento" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <h5 class="text-primary border-bottom pb-2">
                                <i class="fas fa-address-book"></i> Información de Contacto
                            </h5>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Telefono" class="form-label fw-bold">
                                        <i class="fas fa-phone"></i> Teléfono
                                    </label>
                                    <input asp-for="Telefono" class="form-control" type="tel" placeholder="+57 300 1234567" />
                                    <span asp-validation-for="Telefono" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="Correo" class="form-label fw-bold">
                                        <i class="fas fa-envelope"></i> Correo Electrónico
                                    </label>
                                    <input asp-for="Correo" class="form-control" type="email" placeholder="ejemplo@correo.com" />
                                    <span asp-validation-for="Correo" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <h5 class="text-primary border-bottom pb-2">
                                <i class="fas fa-tags"></i> Clasificación
                            </h5>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="TipoCliente" class="form-label fw-bold">
                                        <i class="fas fa-star"></i> Tipo de Cliente *
                                    </label>
                                    <select asp-for="TipoCliente" class="form-select">
                                        <option value="">-- Seleccione --</option>
                                        <option value="Regular">Regular</option>
                                        <option value="VIP">VIP</option>
                                        <option value="Corporativo">Corporativo</option>
                                        <option value="Premium">Premium</option>
                                        <option value="Frecuente">Frecuente</option>
                                    </select>
                                    <span asp-validation-for="TipoCliente" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Sexo" class="form-label fw-bold">
                                        <i class="fas fa-star"></i> Sexo
                                    </label>
                                    <select asp-for="Sexo" class="form-select">
                                        <option value="">-- Seleccione --</option>
                                        <option value="Hombre">Hombre</option>
                                        <option value="Mujer">Mujer</option>
                                    </select>
                                    <span asp-validation-for="Sexo" class="text-danger"></span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label asp-for="Pais" class="form-label fw-bold">
                                        <i class="fas fa-globe"></i> País *
                                    </label>
                                    <input asp-for="Pais" class="form-control" placeholder="Ej: Colombia" />
                                    <span asp-validation-for="Pais" class="text-danger"></span>
                                </div>
                            </div>
                        </div>


                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="fas fa-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-save"></i> Crear Cliente
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}